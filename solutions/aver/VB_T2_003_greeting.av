module Greeting
    intent = "Generates a greeting string from a name using string interpolation."
    exposes [greet]

fn greet(name: String) -> String
    ? "Returns a greeting in the form Hello, <name>!"
    "Hello, {name}!"

verify greet
    greet("Alice") => "Hello, Alice!"
    greet("World") => "Hello, World!"
    greet("Aver") => "Hello, Aver!"

fn main() -> Unit
    ! [Console.print]
    Console.print("{greet("world")}")
    Console.print("{greet("Ada")}")
    Console.print("{greet("x")}")
