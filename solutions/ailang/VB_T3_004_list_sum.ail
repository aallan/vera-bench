module benchmark/solution

type MyList = MyNil | MyCons(int, MyList)

export func list_sum(xs: MyList) -> int =
  match xs {
    MyNil => 0,
    MyCons(h, t) => h + list_sum(t)
  }

export func main() -> () ! {IO} {
  println(show(list_sum(MyNil)));
  println(show(list_sum(MyCons(7, MyNil))));
  println(show(list_sum(MyCons(1, MyCons(2, MyCons(3, MyNil))))));
  println(show(list_sum(MyCons(10, MyCons(-3, MyCons(-7, MyNil))))))
}
