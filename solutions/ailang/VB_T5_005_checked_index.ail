module benchmark/solution

import std/list (nth)

export func safe_index(xs: [int], i: int) -> int =
  match nth(xs, i) {
    Some(v) => v,
    None => -1
  }

export func main() -> () ! {IO} {
  println(show(safe_index([10, 20, 30], 1)));
  println(show(safe_index([10, 20, 30], 0)));
  println(show(safe_index([10, 20, 30], 3)));
  println(show(safe_index([], 0)))
}
