module benchmark/solution

type MyTree = MyLeaf(int) | MyBranch(MyTree, MyTree)

export func tree_sum(t: MyTree) -> int =
  match t {
    MyLeaf(n) => n,
    MyBranch(l, r) => tree_sum(l) + tree_sum(r)
  }

export func main() -> () ! {IO} {
  println(show(tree_sum(MyLeaf(5))));
  println(show(tree_sum(MyBranch(MyLeaf(1), MyLeaf(2)))));
  println(show(tree_sum(MyBranch(MyBranch(MyLeaf(4), MyLeaf(-4)), MyLeaf(9)))))
}
