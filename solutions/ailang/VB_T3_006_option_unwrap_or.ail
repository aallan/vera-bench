module benchmark/solution

type MyOption = MyNone | MySome(int)

export func option_unwrap_or(o: MyOption, default: int) -> int =
  match o {
    MyNone => default,
    MySome(v) => v
  }

export func main() -> () ! {IO} {
  println(show(option_unwrap_or(MySome(5), 0)));
  println(show(option_unwrap_or(MyNone, 99)));
  println(show(option_unwrap_or(MySome(-3), 7)));
  println(show(option_unwrap_or(MyNone, -1)))
}
