module benchmark/solution

type Expr = Lit(int) | Add(Expr, Expr) | Neg(Expr)

export func eval_expr(e: Expr) -> int =
  match e {
    Lit(n) => n,
    Add(a, b) => eval_expr(a) + eval_expr(b),
    Neg(x) => -eval_expr(x)
  }

export func main() -> () ! {IO} {
  println(show(eval_expr(Lit(42))));
  println(show(eval_expr(Add(Lit(2), Lit(3)))));
  println(show(eval_expr(Neg(Lit(7)))));
  println(show(eval_expr(Add(Neg(Lit(4)), Lit(10)))))
}
