module benchmark/solution

type MyList = MyNil | MyCons(int, MyList)
type MyOption = MyNone | MySome(int)

export func list_last(xs: MyList) -> MyOption =
  match xs {
    MyNil => MyNone,
    MyCons(x, MyNil) => MySome(x),
    MyCons(_, t) => list_last(t)
  }

export func main() -> () ! {IO} {
  println(show(list_last(MyCons(1, MyCons(2, MyCons(3, MyNil))))));
  println(show(list_last(MyNil)));
  println(show(list_last(MyCons(7, MyNil))));
  println(show(list_last(MyCons(-1, MyCons(-9, MyNil)))))
}
